# Copy to .env for local development. Secrets never go in the database or source control.
APP_ENV=local
HTTP_ADDR=:8080
SITE_URL=http://localhost:8080
DATABASE_DSN=huduma:huduma@tcp(127.0.0.1:3306)/hudumalink
# Generate with: openssl rand -base64 48
OTP_HMAC_KEY=change-me-to-at-least-32-random-bytes-xxxxxxxx

# Delivery adapters: fake (local only; codes are printed to the log) | smtp | africastalking
EMAIL_ADAPTER=fake
SMS_ADAPTER=fake
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.co.ke
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
# AT_BASE_URL=https://api.africastalking.com   (sandbox: https://api.sandbox.africastalking.com)

# Optional tuning
# SESSION_IDLE_TTL=168h
# SESSION_ABSOLUTE_TTL=720h
# TRUST_PROXY=false        # true only behind a reverse proxy that sets X-Forwarded-For
# WORKER_CONCURRENCY=2

# Integration tests use a separate, disposable database (it is reset on every run).
TEST_DATABASE_DSN=huduma:huduma@tcp(127.0.0.1:3306)/hudumalink_test

# Uploaded media (public images and private verification documents)
MEDIA_DIR=./data/media
