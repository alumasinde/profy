{
  "name": "profy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/publish-build.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "gen:api": "openapi-typescript ../docs/api/openapi.yaml -o src/lib/api/schema.d.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
